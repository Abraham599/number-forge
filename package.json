{
  "name": "number-forge",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "verify:game": "npx tsx src/game/forge/engine.test.ts && npx tsx src/game/forge/coach.test.ts && npx tsx src/game/heap/engine.test.ts && npx tsx src/game/bunch/engine.test.ts && npx tsx src/game/slice/engine.test.ts && npx tsx src/game/weave/engine.test.ts && npx tsx src/progress/dates.test.ts && npx tsx src/progress/mastery.test.ts && npx tsx src/progress/path-progress.test.ts && npx tsx src/smith/parts.test.ts && npx tsx src/curriculum/generate.test.ts && npx tsx src/theme/layout.test.ts",
    "worker:dev": "pnpm --dir worker dev",
    "worker:types": "pnpm --dir worker types"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "expo": "~56.0.12",
    "expo-audio": "~56.0.13",
    "expo-constants": "~56.0.18",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.11",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  }
}
