{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "number-forge-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "number-forge",
      "database_id": "6e0459c4-b61b-4d27-babc-93e07de06883"
    }
  ]
}
